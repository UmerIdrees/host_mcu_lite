# hml_component.cmake -- the single source of truth for hml's component table.
#
# hml is not one library. It is six independently linkable components, and every
# one of them is produced twice: once as a static archive and once as a shared
# object. This file describes the table ONCE, so the two arms generated by
# cmake/hml_static.cmake and cmake/hml_shared.cmake cannot drift apart.
#
#   component     sources                     interface links to      needs a port?
#   ---------     ------------------------   ---------------------   ------------
#   protocol      src/protocol/*.c            -                       no
#   core          src/core/*.c                protocol                no
#   port_posix    ports/posix/*.c             -                       IS the port
#   control       src/control/*.c (no CLIs)   protocol, port_posix    yes
#   udp           src/transports/udp/*.c      core, protocol,         yes
#                                         port_posix
#   rocev2        src/transports/rocev2/*.c   core, protocol,         yes
#                                         port_posix
#
# "needs a port" means: this component calls hml_clock_us() and/or the
# hml_sock_*() family, so a consumer must have already satisfied that contract
# (see include/hml/hml_partition.h). Only `protocol` and `core` are free of it,
# and those two are the whole of the bare-metal-safe surface.

# hml_component_spec(<name> <out_sources> <out_link_names> <out_private_incdirs>)
#
# out_sources is a list of absolute .c paths, out_link_names a list of component
# names (not target names), out_private_incdirs a list of absolute directories
# that are needed to compile but are NOT part of the public include path.
function(hml_component_spec name out_sources out_links out_private)
  if(NOT HML_ROOT)
    message(FATAL_ERROR "hml_component_spec: HML_ROOT must be set to the hml source root")
  endif()

  set(_srcs "")
  set(_links "")
  set(_priv "")

  if(name STREQUAL "protocol")
    file(GLOB _s CONFIGURE_DEPENDS "${HML_ROOT}/src/protocol/*.c")
    set(_srcs ${_s})
  elseif(name STREQUAL "core")
    file(GLOB _s CONFIGURE_DEPENDS "${HML_ROOT}/src/core/*.c")
    set(_srcs ${_s})
    set(_links protocol)
  elseif(name STREQUAL "port_posix")
    file(GLOB _s CONFIGURE_DEPENDS "${HML_ROOT}/ports/posix/*.c")
    set(_srcs ${_s})
  elseif(name STREQUAL "control")
    file(GLOB _s CONFIGURE_DEPENDS "${HML_ROOT}/src/control/*.c")
    # The two *_device/*_host translation units are CLIs, not library code; the
    # in-tree src/control/CMakeLists.txt already carves them out of the library.
    list(FILTER _s EXCLUDE REGEX "/hml_ctrl_(device|host)\\.c$")
    set(_srcs ${_s})
    set(_links protocol port_posix)
    set(_priv "${HML_ROOT}/src/control")
  elseif(name STREQUAL "udp")
    file(GLOB _s CONFIGURE_DEPENDS "${HML_ROOT}/src/transports/udp/*.c")
    set(_srcs ${_s})
    set(_links core protocol port_posix)
    set(_priv "${HML_ROOT}/src/transports/udp")
  elseif(name STREQUAL "rocev2")
    file(GLOB _s CONFIGURE_DEPENDS "${HML_ROOT}/src/transports/rocev2/*.c")
    set(_srcs ${_s})
    set(_links core protocol port_posix)
    set(_priv "${HML_ROOT}/src/transports/rocev2")
  else()
    message(FATAL_ERROR "hml_component_spec: unknown component '${name}'")
  endif()

  set(${out_sources} "${_srcs}" PARENT_SCOPE)
  set(${out_links} "${_links}" PARENT_SCOPE)
  set(${out_private} "${_priv}" PARENT_SCOPE)
endfunction()

# hml_component_list() -> the component names, in dependency order.
function(hml_component_list out)
  set(${out} protocol core port_posix control udp rocev2 PARENT_SCOPE)
endfunction()

# hml_component_is_portless(<name> <out>) -> TRUE for protocol and core.
function(hml_component_is_portless name out)
  if(name STREQUAL "protocol" OR name STREQUAL "core")
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()
