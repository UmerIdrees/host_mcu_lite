# microchip_sam vendor definition -- sourced by renode/scripts/build_vendor.sh.
#
# Every field here is cross-checked against renode/boards/index and against
# firmware/platform/board_config.h, the linker script and the .resc by
# renode/scripts/selfcheck_vendors.sh. Change one, change them all, or the
# <vendor>_renode_selfcheck CTest test goes red.
#
# STATUS: this row has NEVER been executed. See docs/renode_multi_vendor.md.

HML_VENDOR_NAME=microchip_sam
HML_VENDOR_MACHINE=microchip_sam
HML_VENDOR_ARCH=cortex-m7
HML_VENDOR_ELF=microchip_sam_hml_mcu_demo.elf

# Cortex-M7. Thumb-2 only, so -mthumb. Soft float for the same reason as every
# other row in this matrix: nothing here needs an FPU, and enabling CPACR would
# be startup-file work with no payoff. The SAME70 has a double-precision FPU and
# Renode is asked to model cortex-m7, but this image executes no FP instruction.
#
# NOT -mcpu=cortex-m7+nofp and NOT -mfloat-abi=hardfp: neither would be wrong
# per se, but neither buys anything here, and the harder float ABI brings its own
# soft/hard calling-convention rules that this harness has no use for.
HML_VENDOR_ISA_FLAGS="-mcpu=cortex-m7 -mthumb -mfloat-abi=soft"

HML_VENDOR_LIB_SPECS="--specs=nano.specs --specs=nosys.specs"
HML_VENDOR_EXTRA_LDFLAGS=""

# Shared cooperative stub as-is: its tick is the ARMv7-M SysTick COUNTFLAG, which
# a Cortex-M7 has too. Note the consequence of being on an M7: the image runs with
# the data cache and the MPU OFF and never enables them. Nothing here needs them,
# and turning the D-cache on without cache maintenance in hml_reasm's buffers
# would be a correctness bug, not a feature. See the M7 section of the README.
HML_VENDOR_SHARED_STUB=1
HML_VENDOR_TICK=arm-systick-countflag

HML_VENDOR_LINKER_SCRIPT=gcc_microchip_sam_hml_mcu.ld
HML_VENDOR_STARTUP=platform/startup_microchip_sam.c

# The biggest part in the matrix, and the biggest frame cap: 384 KiB of SRAM
# after an 8 KiB stack and roughly 5 KiB of .bss leaves about 366 KiB, so a 128
# KiB frame cap (266 KiB of heap) fits with room to spare. Still nowhere near the
# 2 MiB the library default would want, which is why no row uses --frame-bytes 0.
HML_VENDOR_FRAME_BYTES=131072

HML_VENDOR_CROSS_PREFIX=arm-none-eabi-
