# nxp_lpc vendor definition -- sourced by renode/scripts/build_vendor.sh.
#
# Every field here is cross-checked against renode/boards/index and against
# firmware/platform/board_config.h, the linker script and the .resc by
# renode/scripts/selfcheck_vendors.sh. Change one, change them all, or the
# <vendor>_renode_selfcheck CTest test goes red.
#
# STATUS: this row has NEVER been executed. See docs/renode_multi_vendor.md.

HML_VENDOR_NAME=nxp_lpc
HML_VENDOR_MACHINE=nxp_lpc
HML_VENDOR_ARCH=cortex-m4
HML_VENDOR_ELF=nxp_lpc_hml_mcu_demo.elf

# Same ISA as the base platform: plain Thumb-2 Cortex-M4 C, identical flags.
HML_VENDOR_ISA_FLAGS="-mcpu=cortex-m4 -mthumb"

HML_VENDOR_LIB_SPECS="--specs=nano.specs --specs=nosys.specs"
HML_VENDOR_EXTRA_LDFLAGS=""

# The shared cooperative stub's tick is the ARMv7-M SysTick COUNTFLAG, which is
# real hardware on this part and is modelled by Renode's NVIC, so the shared
# stub is compiled as-is.
HML_VENDOR_SHARED_STUB=1
HML_VENDOR_TICK=arm-systick-countflag

HML_VENDOR_LINKER_SCRIPT=gcc_nxp_lpc_hml_mcu.ld
HML_VENDOR_STARTUP=platform/startup_nxp_lpc.c

# This part has no external SDRAM either, so it gets an explicit cap like every
# other non-SDRAM row. See renode/vendors/nxp_lpc/README.md.
HML_VENDOR_FRAME_BYTES=32768

HML_VENDOR_CROSS_PREFIX=arm-none-eabi-
