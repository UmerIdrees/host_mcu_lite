# riscv vendor definition -- sourced by renode/scripts/build_vendor.sh.
#
# Every field here is cross-checked against renode/boards/index and against
# firmware/platform/board_config.h, the linker script and the .resc by
# renode/scripts/selfcheck_vendors.sh. Change one, change them all, or the
# riscv_renode_selfcheck CTest test goes red.
#
# STATUS: this row has NEVER been executed. See docs/renode_multi_vendor.md.

HML_VENDOR_NAME=riscv
HML_VENDOR_MACHINE=riscv
HML_VENDOR_ARCH=rv32imac
HML_VENDOR_ELF=riscv_hml_mcu_demo.elf

# rv32iac for the integer/atomic core, M for the integer multiply/divide the
# library actually uses. NO floating point extension and NO bitmanip: nothing in
# the library needs F or B, and this is a 32-bit ABI (ilp32) so the image is
# pointer-native. The toolchain is riscv32-unknown-elf-, which is NOT the
# arm-none-eabi- one every ARM row uses -- that is the whole point of the row.
#
# -msdata=none: no gp-relative addressing, so the linker script needs no .sdata
# / .sbss and startup_riscv.c does not have to initialise the gp register.
HML_VENDOR_ISA_FLAGS="-march=rv32imac -mabi=ilp32 -msdata=none"

# RISC-V newlib tools do not reliably provide the nanolib variant, so this row
# uses only what freertos-demo was verified to need: nosys for the abort-style
# errno plumbing. NOT nano.specs.
HML_VENDOR_LIB_SPECS="--specs=nosys.specs"

# Define __riscv_float_abi_soft etc. for headers, and keep RISC-V linker
# relaxation OFF: relax migrates code between sections at link time, and the
# self-check asserts the .resc VectorTableOffset and the linker FLASH ORIGIN
# agree. A relaxed 0-address reset handler would still be at 0, but a relaxed
# instruction could silently change the MTIMECMP/dead-loop layout, so this row
# pins it off and says so in startup_riscv.c.
HML_VENDOR_EXTRA_LDFLAGS="-Wl,--no-relax"

# DIFFERENT FROM EVERY ARM ROW: the shared freertos_stub.c is NOT compiled here.
# Its tick is the ARMv7-M SysTick COUNTFLAG, and RISC-V has no SysTick. The whole
# FreeRTOS-shim API surface is instead implemented inside
# firmware/platform/startup_riscv.c, which ticks on the MMIO machine timer
# (CLINT mtime) with the same bounded-spin fallback. Because the headers are
# still the shared NOT-FreeRTOS ones, the demo body compiles unchanged.
HML_VENDOR_SHARED_STUB=0
HML_VENDOR_TICK=riscv-mtime

HML_VENDOR_LINKER_SCRIPT=gcc_riscv_hml_mcu.ld
HML_VENDOR_STARTUP=platform/startup_riscv.c

# The smallest frame cap in the matrix, on the smallest part in the matrix: 32
# KiB of SRAM after a 4 KiB stack and roughly 5 KiB of .bss leaves about 22 KiB,
# so 18432 bytes of heap means a 4096-byte frame cap. Same code paths, same
# checks, smaller frame cap.
HML_VENDOR_FRAME_BYTES=4096

HML_VENDOR_CROSS_PREFIX=riscv32-unknown-elf-