# stm32f4 vendor definition -- sourced by renode/scripts/build_vendor.sh.
#
# Every field here is cross-checked against renode/boards/index and against
# firmware/platform/board_config.h, the linker script and the .resc by
# renode/scripts/selfcheck_vendors.sh. Change one, change them all, or the
# <vendor>_renode_selfcheck CTest test goes red.
#
# STATUS: this row has NEVER been executed. See docs/renode_multi_vendor.md.

HML_VENDOR_NAME=stm32f4
HML_VENDOR_MACHINE=stm32f4
HML_VENDOR_ARCH=cortex-m4
HML_VENDOR_ELF=stm32f4_hml_mcu_demo.elf

# ISA. The image is plain Thumb-2 Cortex-M4 C: this is exactly the flags
# build_mcu.sh uses for the base platform, so nothing about the compiler
# invocation for the ARM vendors is a guess.
HML_VENDOR_ISA_FLAGS="-mcpu=cortex-m4 -mthumb"

# newlib: nano for size, nosys for the syscall stubs. Nothing else is linked,
# because nothing socket-shaped is used and a second syscall provider would
# produce duplicate symbols.
HML_VENDOR_LIB_SPECS="--specs=nano.specs --specs=nosys.specs"
HML_VENDOR_EXTRA_LDFLAGS=""

# The shared cooperative stub in renode/firmware/freertos_demo/stub_freertos is
# compiled as-is: its tick is the ARMv7-M SysTick COUNTFLAG, which is real
# hardware on this part and is modelled by Renode's NVIC.
HML_VENDOR_SHARED_STUB=1

# SysTick still does not have to advance for the run to succeed: the shared
# stub has a bounded spin fallback and the demo prints
# HML-MCU-DEMO-WARN systick-did-not-advance rather than hanging.
HML_VENDOR_TICK=arm-systick-countflag

HML_VENDOR_LINKER_SCRIPT=gcc_stm32f4_hml_mcu.ld
HML_VENDOR_STARTUP=platform/startup_stm32f4.c
HML_VENDOR_FRAME_BYTES=32768

HML_VENDOR_CROSS_PREFIX=arm-none-eabi-
