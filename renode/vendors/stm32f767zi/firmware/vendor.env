# stm32f767zi vendor definition -- sourced by renode/scripts/build_vendor.sh.
#
# Every field here is cross-checked against renode/boards/index and against
# firmware/platform/board_config.h, the linker script and the .resc by
# renode/scripts/selfcheck_vendors.sh. Change one, change them all, or the
# stm32f767zi_renode_selfcheck CTest test goes red.
#
# THIS IS THE NETWORK ROW. The other four vendor machines have no network
# peripheral at all, so this is the only one whose image can put a frame on an
# emulated wire. See the STATUS block in firmware/platform/board_config.h.

HML_VENDOR_NAME=stm32f767zi
HML_VENDOR_MACHINE=stm32f767zi
HML_VENDOR_ARCH=cortex-m7
HML_VENDOR_ELF=stm32f767zi_hml_mcu_demo.elf

# Cortex-M7 with the double-precision FPU. -mfloat-abi=hard matches the part
# (FPU present, and the cache/MPU paths the startup file initialises).
HML_VENDOR_ISA_FLAGS="-mcpu=cortex-m7 -mthumb -mfloat-abi=hard -mfpu=fpv5-d16"

# newlib: nano for size, nosys for the syscall stubs. A single syscall provider,
# or the link fails on duplicate symbols. lwIP's sys_arch is supplied by the
# vendor's own startup file, not by newlib, so this stays the only provider.
HML_VENDOR_LIB_SPECS="--specs=nano.specs --specs=nosys.specs"
HML_VENDOR_EXTRA_LDFLAGS=""

# The shared cooperative stub is linked unchanged: its tick is the ARMv7-M
# SysTick COUNTFLAG, which is real on this part and modelled by Renode's NVIC.
HML_VENDOR_SHARED_STUB=1

# SysTick does not have to advance for the run to succeed: the shared stub has a
# bounded spin fallback and the demo prints
# HML-MCU-DEMO-WARN systick-did-not-advance rather than hanging. This matters
# more than on the other rows: lwIP's TCP timers are driven from the same tick,
# so a stalled tick would leave the stack's timers frozen.
HML_VENDOR_TICK=arm-systick-countflag

HML_VENDOR_LINKER_SCRIPT=gcc_stm32f767zi_hml_mcu.ld
HML_VENDOR_STARTUP=platform/startup_stm32f767zi.c
HML_VENDOR_FRAME_BYTES=65536

HML_VENDOR_CROSS_PREFIX=arm-none-eabi-
