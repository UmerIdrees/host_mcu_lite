# ti_tm4c vendor definition -- sourced by renode/scripts/build_vendor.sh.
#
# Every field here is cross-checked against renode/boards/index and against
# firmware/platform/board_config.h, the linker script and the .resc by
# renode/scripts/selfcheck_vendors.sh. Change one, change them all, or the
# <vendor>_renode_selfcheck CTest test goes red.
#
# STATUS: this row has NEVER been executed. See docs/renode_multi_vendor.md.

HML_VENDOR_NAME=ti_tm4c
HML_VENDOR_MACHINE=ti_tm4c
HML_VENDOR_ARCH=cortex-m4f
HML_VENDOR_ELF=ti_tm4c_hml_mcu_demo.elf

# The TM4C1294 has an FPU, which is why arch=cortex-m4f above and why Renode is
# asked for cpuType "cortex-m4f". The image is nevertheless compiled SOFT FLOAT:
# a demo that ran FP instructions would need the FPU enabled, the CPACR bits set
# and lazy stacking configured, and none of that exists here. Nothing in this
# matrix needs it, so the code stays integer-only and the mismatch is deliberate
# rather than an oversight. Do NOT "fix" this by adding -mfpu without also
# adding the CP10/CP11 enable to the startup file.
HML_VENDOR_ISA_FLAGS="-mcpu=cortex-m4 -mthumb -mfloat-abi=soft"

HML_VENDOR_LIB_SPECS="--specs=nano.specs --specs=nosys.specs"
HML_VENDOR_EXTRA_LDFLAGS=""

# Shared cooperative stub as-is: its tick is the ARMv7-M SysTick COUNTFLAG.
HML_VENDOR_SHARED_STUB=1
HML_VENDOR_TICK=arm-systick-countflag

HML_VENDOR_LINKER_SCRIPT=gcc_ti_tm4c_hml_mcu.ld
HML_VENDOR_STARTUP=platform/startup_ti_tm4c.c

# 256 KiB of SRAM: an 8 KiB stack and roughly 5 KiB of .bss leave about 240 KiB,
# so a 64 KiB frame cap (138 KiB of heap) fits with room to spare. Bigger than
# the two 128 KiB parts and much smaller than the 384 KiB SAME70.
HML_VENDOR_FRAME_BYTES=65536

HML_VENDOR_CROSS_PREFIX=arm-none-eabi-
